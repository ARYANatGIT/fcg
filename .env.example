# Application Environment
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Operational Data Mode (synthetic | imd | ncmrwf | era5)
DATA_MODE=synthetic
SYNTHETIC_DATA_PATH=data/synthetic/weather_demo.parquet
PROCESSED_DATA_PATH=data/processed/forecast_errors.parquet

# Meteorological Grid Configuration (India Bounding Box)
GRID_RESOLUTION=0.5
LAT_MIN=8.0
LAT_MAX=37.0
LON_MIN=68.0
LON_MAX=97.0

# Bust Detection Thresholds
BUST_PERCENTILE_THRESHOLD=90.0

# External Data Directory Mounts (MoES / NCMRWF / IMD)
IMD_DATA_DIR=data/raw/imd
NCMRWF_DATA_DIR=data/raw/ncmrwf

# Database Connection (Default fallback: SQLite; Optional: PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///./data/forecastguard.db
