# Application Environment
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Google Maps API Key
GOOGLE_MAPS_API_KEY=AIzaSyAEF1qpY_JKBSAtYlTXteRk_FOxKRM2r5s

# MongoDB Connection (Local, Docker, or MongoDB Atlas cloud URI)
# Example local: mongodb://localhost:27017
# Example Docker: mongodb://mongodb:27017/forecastguard
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/forecastguard?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=forecastguard

# Operational Data Mode (synthetic | real_time | imd | ncmrwf | era5)
DATA_MODE=real_time
SYNTHETIC_DATA_PATH=data/synthetic/weather_demo.parquet
PROCESSED_DATA_PATH=data/processed/forecast_errors.parquet

# Schedulers Configuration
INGESTION_INTERVAL_MINUTES=10
RETRAINING_INTERVAL_HOURS=12

# Meteorological Grid Configuration (India Bounding Box)
GRID_RESOLUTION=0.5
LAT_MIN=8.0
LAT_MAX=37.0
LON_MIN=68.0
LON_MAX=97.0

# Bust Detection Thresholds
BUST_PERCENTILE_THRESHOLD=90.0

# External Data Directory Mounts (MoES / NCMRWF / IMD)
IMD_DATA_DIR=data/raw/imd
NCMRWF_DATA_DIR=data/raw/ncmrwf

# Database Connection (Default fallback: SQLite; Optional: PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///./data/forecastguard.db
